# OpenAI
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# 매장 설정
BUSINESS_NAME=샘플 매장
BUSINESS_TYPE=가족 체험 공간
CUSTOMER_AUDIENCE=가족 단위 고객
REPLY_TONE=친절하고 따뜻하며 자연스러운 말투

# 본인이 관리 권한을 가진 네이버 스마트플레이스 리뷰 관리 URL
NAVER_REVIEW_URL=https://new.smartplace.naver.com/your-review-management-page

# 프로젝트 내부의 전용 폴더 사용을 권장합니다.
BROWSER_PROFILE_DIR=./browser_profile

# 실행 설정
MAX_REPLIES=10
AUTO_REGISTER=false
OUTPUT_FILE=./output/review_replies.xlsx

